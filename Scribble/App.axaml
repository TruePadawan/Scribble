<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Scribble"
             xmlns:converters="using:Scribble.Converters"
             x:Class="Scribble.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <converters:EnumToBoolConverter x:Key="EnumBoolConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />

            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="avares://Scribble/Assets/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
    </Application.Styles>
</Application>